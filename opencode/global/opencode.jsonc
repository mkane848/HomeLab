{
  "$schema": "https://opencode.ai/config.json",

  // Default model (change per profile or override in project config)
  "model": "{env:OPENCODE_MODEL}",
  "small_model": "{env:OPENCODE_SMALL_MODEL}",

  // "notify", not true. With true opencode installs PATCH releases by itself
  // whenever a TUI starts (never from `opencode run`), so the binary can change
  // under a running benchmark batch: the results corpus spans opencode 1.18.31,
  // .32 and .33 in ten days, and a cell's replicates straddled two versions.
  // "notify" still says when an update exists. Upgrade on purpose with
  // `opencode upgrade` between batches and treat the new version as a new era
  // in tests/results/. OPENCODE_DISABLE_AUTOUPDATE=1 pins it too. Only the
  // GLOBAL config is read for this. Source: docs/references.md (opencode-upgrade).
  "autoupdate": "notify",

  "shell": "pwsh",

  // Keeps a session working after an automatic compaction (installed
  // 2026-10-05; docs/roadmap.md -> "Context overflow"). Referenced in place
  // from the desktop's main checkout, like the project skill paths, so it
  // follows whatever branch M:\Projects\dev-docs has checked out. It rests on
  // EXPERIMENTAL opencode hooks read at 1.18.34: after `opencode upgrade`, run
  // tests/test-compaction-plugin.ps1 before trusting it. To take it out, delete
  // this entry and re-run sync-opencode.ps1 -Template. The path is the
  // desktop's; on another host the plugin fails to load (opencode reports it
  // and carries on).
  //
  // read-budget.js (2026-10-17) keeps one `read` from eating the window: it
  // caps a read at ~8% of the model's context window (about 17,300 chars at
  // 64k), tells the model to grep instead, and shrinks a file that has used
  // 25% of the window since the last compaction to 100-line reads. Born of
  // kane-08, where two whole-file reads of 131 and 185 KB overflowed the 64k
  // window 17 to 19 times a run. Same in-place reference and same removal as
  // above; HOMELAB_READ_MAX_CHARS=off switches it off for one launch. Guard:
  // tests/test-read-budget.ps1 (FAILs on any opencode but 1.18.34).
  "plugin": [
    "file:///M:/Projects/dev-docs/opencode/plugins/compaction-continue.js",
    "file:///M:/Projects/dev-docs/opencode/plugins/read-budget.js"
  ],

  // Shell output is capped at 16 KB a call (opencode's `tool_output`, from
  // core/src/config/tool-output.ts at v1.18.34, not in the documentation;
  // `opencode debug config` keeps it, and a misspelt key is dropped without a
  // word). Not yet measured live: whether the shell tool honours it is for the
  // kane-08 / wp-4a round to show.
  "tool_output": { "max_bytes": 16384 },

  // ---------------------------------------------------------------------
  // MODEL ENTRY SCHEMA - read this before adding a model.
  //
  // opencode validates model entries against its published schema and
  // SILENTLY DROPS keys it does not know. This config used to declare
  // "context_window": N and "input": ["text"]; neither is a real key, so
  // every model resolved with NO limits at all. opencode then never trimmed
  // the prompt and reserved its ~8192-token default for output, and Ollama
  // answered with:
  //     truncating input prompt limit=8194 prompt=46505 keep=4
  // i.e. the entire system prompt was thrown away and the request 500'd.
  //
  // The real keys are:
  //     "limit":      { "context": N, "output": N }
  //     "modalities": { "input": ["text"], "output": ["text"] }
  //     "tool_call":  true
  //
  // RULES:
  //  1. limit.context must be <= what the host actually SERVES for that tag
  //     (server: OLLAMA_CONTEXT_LENGTH; desktop: the num_ctx baked by
  //     startup.ps1). Over-promising brings the truncation back.
  //  2. limit.output is subtracted from limit.context to get the usable
  //     prompt window. Keep it generous for reasoning models (they burn
  //     budget on the reasoning block - see AGENTS.md Gotchas) but never so
  //     large that it eats the window: 4096-8192 for reasoners, 2048 for
  //     plain coders.
  //  3. After editing, ALWAYS confirm with `opencode debug config` that the
  //     resolved entry still shows `limit`. If it is missing, the key was
  //     rejected and you are back to the truncation bug.
  // ---------------------------------------------------------------------

  "provider": {

    "opencode-go": {
      "options": {
        "apiKey": "{file:.secrets/opencode-go-api-key}"
      }
    },

    // One ollama provider PER HOST: a single ollama provider with one baseURL
    // cannot reach two machines. Each profile sets the *_BASE_URL env vars.
    // Model IDs look like: ollama-server/qwen2.5-coder:7b

    // Server context: a tag listed in models/server-seats.tsv, which
    // server/scripts/bake-models.sh bakes (the server half of startup.ps1
    // $contextModels), serves at its baked num_ctx - qwen3.6 65536, qwen3:8b
    // 32768, the 3b 16384; keep those entries here in step with that table
    // (test-profiles.ps1 checks limit.context against what the server serves).
    // Every other tag serves at OLLAMA_CONTEXT_LENGTH
    // (server/docker/.env, 16384 by default), so its entry is capped at 16384.
    // tool_call here reflects the DESKTOP probe of the same weights
    // (tests/test-toolcalls.ps1) unless a server probe is logged for the tag in
    // tests/results/toolcalls-summary.tsv (host "server"). gemma3, codestral,
    // gpt-oss and qwq are NOT installed anywhere yet and are therefore
    // UNPROBED - their "tool_call": true is an assumption. Probe before
    // seating any of them. glm4 IS measured: FAIL on node3 2026-09-20 (ignored
    // the tool, answered in prose). The server copy itself is unprobed - re-probe
    // it there before trusting this entry.
    "ollama-server": {
      "models": {
        // MAIN SEAT of dev-workflow-server (same weights and bake as the
        // desktop's seat; server placement on 16 GB CUDA is measured separately,
        // docs/roadmap.md -> "Next up", step 3).
        "qwen3.6:35b-a3b-coding": {
          "name": "Qwen3.6 35B-A3B Coding (Server, main seat, offloads)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["image", "text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 65536, "output": 8192 }
        },
        // The 3b with num_gpu 0 (a derived row of models/server-seats.tsv): runs on the CPU, so
        // as the small model it cannot evict qwen3.6 (see the desktop entry).
        "qwen2.5-coder-3b-cpu": {
          "name": "Qwen 2.5 Coder 3B (Server, CPU, small)",
          "attachment": true,
          "reasoning": false,
          "tool_call": false,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 2048 }
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B (Server)",
          "attachment": true,
          "reasoning": false,
          "tool_call": false,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 2048 }
        },
        "qwen2.5-coder:14b": {
          "name": "Qwen 2.5 Coder 14B (Server)",
          "attachment": true,
          "reasoning": false,
          "tool_call": false,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 2048 }
        },
        "deepseek-r1:14b": {
          "name": "DeepSeek-R1 14B (Server)",
          "attachment": true,
          "reasoning": true,
          "tool_call": false,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 4096 }
        },
        "qwen3:8b": {
          "name": "Qwen3 8B (Server)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 32768, "output": 4096 }
        },
        "qwen3:14b": {
          "name": "Qwen3 14B (Server)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 4096 }
        },
        "gemma3:12b": {
          "name": "Gemma3 12B (Server)",
          "attachment": true,
          "reasoning": false,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 2048 }
        },
        // tool_call false: the same weights FAILED the probe on node3 (2026-09-20);
        // the server copy was never probed, so assume no tools until it is.
        "glm4:9b": {
          "name": "GLM4 9B (Server, NO TOOLS)",
          "attachment": true,
          "reasoning": false,
          "tool_call": false,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 2048 }
        },
        "codestral": {
          "name": "Codestral 22B (Server, edge)",
          "attachment": true,
          "reasoning": false,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 2048 }
        },
        "gpt-oss:20b": {
          "name": "GPT-OSS 20B (Server, edge)",
          "attachment": true,
          "reasoning": false,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 2048 }
        },
        "qwq:32b": {
          "name": "QwQ 32B (Server, CPU offload)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 4096 }
        }
      },
      "options": {
        "baseURL": "{env:OLLAMA_SERVER_BASE_URL}"
      }
    },

    // Desktop context comes from the num_ctx baked into each tag by
    // startup.ps1 ($contextModels). Keep this table and $contextModels in sync
    // - they are the two halves of one contract, and a mismatch brings back the
    // truncation bug described at the top of this file.
    //
    // 32768: qwen3:14b, qwen3:8b, qwen2.5-coder:14b, deepseek-r1-32k
    // 16384: everything else
    //
    // Why the agent seats need 32k: the system prompt plus tool schemas measure
    // 11,441 tokens. At 16k that leaves ~850 tokens of real working room once
    // output is reserved; at 32k it is ~17,200.
    "ollama-desktop": {
      "models": {
        // No-tools model. Good code TEXT, cannot edit a file - it prints the
        // tool call as chat instead (tests/test-toolcalls.ps1). Switch to it
        // deliberately for explanation or review, never to drive a session.
        "qwen2.5-coder:14b": {
          "name": "Qwen 2.5 Coder 14B 32k ctx (Desktop, NO TOOLS)",
          "attachment": true,
          "reasoning": false,
          "tool_call": false,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 32768, "output": 4096 }
        },
        // No-tools deep reasoner (code text, review). Baked at 32768. /plan
        // runs on the main agent - there is no planner subagent any more.
        "deepseek-r1-32k": {
          "name": "DeepSeek-R1 14B 32k ctx (Desktop)",
          "attachment": true,
          "reasoning": true,
          "tool_call": false,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 32768, "output": 8192 }
        },
        // Kept at 16384 for anything still referencing the older alias.
        "deepseek-r1-16k": {
          "name": "DeepSeek-R1 14B 16k ctx (Desktop)",
          "attachment": true,
          "reasoning": true,
          "tool_call": false,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 4096 }
        },
        "deepseek-r1:14b": {
          "name": "DeepSeek-R1 14B (Desktop)",
          "attachment": true,
          "reasoning": true,
          "tool_call": false,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 4096 }
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B (Desktop)",
          "attachment": true,
          "reasoning": false,
          "tool_call": false,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 2048 }
        },
        // Derived 7b alias baked by startup.ps1; the coder subagent uses it.
        "qwen2.5-coder-16k": {
          "name": "Qwen 2.5 Coder 7B 16k ctx (Desktop)",
          "attachment": true,
          "reasoning": false,
          "tool_call": false,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 2048 }
        },
        // Small/companion model on the GPU. It stayed resident next to qwen3:14b
        // (13.29 GB); the 7b does not. Next to qwen3.6 it evicts the main seat,
        // which is why dev-workflow-quality uses the CPU copy below.
        "qwen2.5-coder:3b": {
          "name": "Qwen 2.5 Coder 3B (Desktop, small)",
          "attachment": true,
          "reasoning": false,
          "tool_call": false,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 2048 }
        },
        // The same 3b with num_gpu 0 baked in: runs on the CPU, needs no VRAM.
        // Small model of dev-workflow-quality since 2026-10-03. qwen3.6 spills
        // to system RAM and takes every GPU byte, so the GPU 3b evicted it at
        // each session start; this one did not (docs/main-seat-trial.md ->
        // "Second experiment", 0 evictions in 3 sessions). Derived by
        // startup.ps1 ($derivedModels).
        "qwen2.5-coder-3b-cpu": {
          "name": "Qwen 2.5 Coder 3B (Desktop, CPU, small)",
          "attachment": true,
          "reasoning": false,
          "tool_call": false,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 2048 }
        },
        // Lighter agent seat (dev-workflow-resident). Measured at 32k: 7.16 GB,
        // 100% on GPU, 79.8 tok/s. With the 3b that is 9.42 GB, which still
        // fits alongside a running game (~12.5 GB available).
        "qwen3:8b": {
          "name": "Qwen3 8B (Desktop) - tool-capable",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 32768, "output": 4096 }
        },
        // Main seat of dev-workflow-quality from 2026-09-17 to 2026-10-03 (now
        // qwen3.6, below). Probed 2026-09-17: PASS in 11.9s. Measured at 32k:
        // 11.03 GB, 100% on GPU, 48.9 tok/s. Pairs with the 3b small model at
        // 13.29 GB of ~14.8 GB usable.
        //
        // output 4096 -> 8192 (2026-09-21). At 4096 this seat ran out of output
        // budget inside its own reasoning block on 8 of 16 task-veracity runs:
        // step_finish reason "length", usage output exactly 4096, with ~25k of
        // the context window still unused - so the cap, not the window. On
        // kane-01 it hit that cap before emitting any edit call on 7 of 9 runs,
        // leaving the seat with almost no gradable data and making every
        // 14b-vs-8b comparison drawn from it invalid. 8192 is the reasoner
        // budget the RULES block at the top of this file already prescribes
        // (4096-8192 for reasoners); the prompt window is still 32768 - 8192 =
        // 24,576, comfortably clear of the measured 14,364-token preamble.
        // The 8b carries the same cap and rarely reaches it - it reasons less
        // before acting - so this is a 14b ceiling, not a fleet-wide one.
        "qwen3:14b": {
          "name": "Qwen3 14B 32k ctx (Desktop) - former main seat",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 32768, "output": 8192 }
        },
        // 64k (trialled + adopted 2026-09-27, DP8): qwen3-coder, qwen3.5, north-mini, laguna, qwen3.6
        // and nemotron carry limit.context 65536, matching the num_ctx baked by
        // startup.ps1 ($contextModels). The devstral pair and the qwen3 dense
        // pair stay 32768. Measurements + acceptance rule: docs/roadmap.md ->
        // "Context budget: 32k vs 64k per seat".
        // Agentic coding specialist (Mistral). 14 GB of weights on a ~14.8 GB
        // usable card, so it WILL partially offload to system RAM and run
        // slow. Registered for evaluation, not as a default seat.
        "devstral:24b": {
          "name": "Devstral 24B (Desktop, offloads)",
          "attachment": true,
          "reasoning": false,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 32768, "output": 4096 }
        },
        // Imported from a local GGUF, 2026-09-18 (no re-download): ollama create
        // FROM the file. A3B MoE coder. Probed 2026-09-18: tool_calls PASS in 24.8s - but 17.35 GB of
        // weights on a ~14.8 GB usable card mean it partially offloads and runs
        // slow. Context 32768 since 2026-09-22 (baked by
        // startup.ps1; at 16384 the ~14.4k preamble plus the 4096 output
        // reserve did not fit), 65536 since the 2026-09-27 trial (DP8).
        "qwen3-coder:30b-a3b": {
          "name": "Qwen3 Coder 30B A3B (Desktop, imported, offloads)",
          "attachment": true,
          "reasoning": false,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 65536, "output": 4096 }
        },
        // Imported from a local Q8_0 GGUF, 2026-09-18. Probed 2026-09-18:
        // tool_calls PASS in 14.1s. Same Qwen3.5 family as the A3B coder above
        // plus a vision projector (mmproj). Images ride in via /v1 chat.
        "qwen3.5:9b": {
          "name": "Qwen3.5 9B (Desktop, imported, vision)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["image", "text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 65536, "output": 4096 }
        },
        // Imported from a local Q8_0 GGUF, 2026-09-18. R1-style hybrid. Probed
        // 2026-09-18: tool_calls FAIL (ignores tools, answers in prose) - a
        // no-tools reviewer/explainer seat, like the other R1.
        "deepseek-r1-0528:8b": {
          "name": "DeepSeek-R1 0528 Qwen3 8B (Desktop, imported, NO TOOLS)",
          "attachment": true,
          "reasoning": true,
          "tool_call": false,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 8192 }
        },
        // Executor candidates, 2026-09-22 Ollama library scan (docs/hardware.md
        // -> "Candidate executor models"). Registered AHEAD of the tool-call probe
        // so run-tasks-batch.ps1 -Mode Both can batch whichever pass in one run;
        // the script drops any seat whose current-version probe is not PASS, so
        // tool_call here is a claim to be confirmed. Flip a FAIL to false
        // (see tests/results/toolcalls-summary.tsv). reasoning/modalities follow
        // /api/show capabilities. Context is baked by startup.ps1: 32768 for the
        // dense devstral-small-2, 65536 for the MoE seats (2026-09-27 trial).
        "devstral-small-2:24b": {
          "name": "Devstral Small 2 24B (Desktop, candidate, dense, offloads)",
          "attachment": true,
          "reasoning": false,
          "tool_call": true,
          "modalities": { "input": ["image", "text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 32768, "output": 4096 }
        },
        "north-mini-code-1.0": {
          "name": "North Mini Code 1.0 30B-A3B (Desktop, candidate, offloads)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 65536, "output": 4096 }
        },
        "laguna-xs-2.1": {
          "name": "Laguna XS 2.1 33B-A3B (Desktop, candidate, offloads)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 65536, "output": 4096 }
        },
        // MAIN SEAT of dev-workflow-quality since 2026-10-03
        // (docs/main-seat-trial.md). 64k: 21.13 GB, of which 12.51 GB on the
        // GPU and the rest in system RAM; its small model is the CPU 3b above.
        // Starting-build planner seat (agreed 2026-09-23): a plan carries
        // multi-order work orders plus acceptance tests, which does not fit
        // the 4096 executor budget (the qwen3:14b truncation trap) - 8192.
        "qwen3.6:35b-a3b-coding": {
          "name": "Qwen3.6 35B-A3B Coding (Desktop, main seat, offloads)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["image", "text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 65536, "output": 8192 }
        },
        "nemotron-3.5-lightning": {
          "name": "Nemotron 3.5 Lightning 30B-A3B (Desktop, candidate, offloads)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 65536, "output": 4096 }
        }
      },
      "options": {
        "baseURL": "{env:OLLAMA_DESKTOP_BASE_URL}"
      }
    },

    // The third node (RTX 3080 FE) - only meaningful when dev-node3.sh sets
    // OLLAMA_NODE3_BASE_URL to its IP.
    "ollama-node3": {
      "models": {
        // MEASURED 2026-09-21, healthy node: /api/ps with qwen3:8b loaded
        // reports context_length 32768 and size_vram 7.84 GiB (8,416,489,635
        // bytes) on Ollama 0.34.2. The onboarding-default 16384 this used to
        // read was a guess, and the 32768 bump that briefly replaced it was
        // justified by "6/6 liar-mode runs" that turned out to be six 307-byte
        // "Cannot connect to API" transcripts - neither number had a
        // measurement behind it. This one does.
        //
        // 32768 aligns node3's seat with desktop's qwen3:8b (also 32768,
        // baked by startup.ps1) and clears the preamble-budget arithmetic:
        // 16384 minus the 4096 output reserve left ~12,288 tokens of input
        // budget against a measured 14,364-token preamble - over budget before
        // the task prompt. 7.84 GiB of the 3080 FE's 10 GB at 32k ctx leaves
        // ~2 GiB, so glm4:9b (5.5 GB) cannot co-reside with it loaded; that is
        // a VRAM juggling constraint, not a correctness one.
        //
        // No context-baking step exists on node3 (unlike desktop's
        // startup.ps1), so the served window comes from the daemon's own
        // OLLAMA_CONTEXT_LENGTH. Re-verify with
        //   curl http://NODE3_IP:11434/api/ps   # context_length when loaded
        // if node3's Ollama is ever restarted with a different env.
        "qwen3:8b": {
          "name": "Qwen3 8B (Node3)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 32768, "output": 4096 }
        },
        // Measured FAIL on the real probe (2026-09-20, node3):
        // ignored the tool entirely and answered in prose. Do not flip this
        // back to true without a new passing tests/test-toolcalls.ps1 run -
        // see AGENTS.md Gotchas. No-tools chat model only, like
        // qwen2.5-coder:14b.
        "glm4:9b": {
          "name": "GLM4 9B (Node3, NO TOOLS)",
          "attachment": true,
          "reasoning": false,
          "tool_call": false,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 2048 }
        },
        // Executor candidates, 2026-09-22 Ollama library scan (docs/hardware.md
        // -> "Candidate executor models"). Registered AHEAD of the tool-call probe
        // so run-tasks-batch.ps1 -Mode Both can batch whichever pass in one run;
        // the script drops any seat whose current-version probe is not PASS, so
        // tool_call here is a claim to be confirmed. Flip a FAIL to false
        // (see tests/results/toolcalls-summary.tsv). reasoning/modalities follow
        // /api/show capabilities. Context 32768 = node3's OLLAMA_CONTEXT_LENGTH (no baking step there).
        "ornith:9b": {
          "name": "Ornith 9B (Node3, candidate)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 32768, "output": 4096 }
        },
        "ministral-3:8b": {
          "name": "Ministral 3 8B (Node3, candidate)",
          "attachment": true,
          "reasoning": false,
          "tool_call": true,
          "modalities": { "input": ["image", "text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 32768, "output": 4096 }
        },
        "lfm2.5:8b": {
          "name": "LFM2.5 8B-A1B (Node3, candidate)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 32768, "output": 4096 }
        }
      },
      "options": {
        "baseURL": "{env:OLLAMA_NODE3_BASE_URL}"
      }
    },

    // ---- llama.cpp providers (docs/roadmap.md -> "Replacing Ollama", Phase 2) ----
    // One provider per host again, one llama-server (router mode) per host. Only
    // the server has one so far (server/docker/docker-compose.llamacpp.yml, port
    // 8090); the desktop and node3 blocks are registered ahead of Phases 4 and 5
    // and mirror the same three seats, so those hosts have NO llama-server until
    // then. limit.context equals `c` in server/llamacpp/models.ini
    // (tests/test-profiles.ps1 checks it against /props).

    "llamacpp-server": {
      "models": {
        // Model ids are the preset's section names / aliases
        // (server/llamacpp/models.ini), same tags as the ollama-server seats.
        // Text only: the vision projector (mmproj) is not loaded, so these do not
        // list image input even where the Ollama copy does. No "npm" field: OpenCode
        // gives a config-defined provider @ai-sdk/openai-compatible (docs/llamacpp-trial.md, step 6).
        "qwen3.6:35b-a3b-coding": {
          "name": "Qwen3.6 35B-A3B Coding (Server, main seat, llama.cpp)",
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 65536, "output": 8192 }
        },
        "qwen3:8b": {
          "name": "Qwen3 8B (Server, llama.cpp)",
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 32768, "output": 4096 }
        },
        "qwen2.5-coder-3b-cpu": {
          "name": "Qwen 2.5 Coder 3B (Server, CPU, small, llama.cpp)",
          "attachment": false,
          "reasoning": false,
          "tool_call": false,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 2048 }
        }
      },
      "options": {
        "baseURL": "{env:LLAMACPP_SERVER_BASE_URL}"
      }
    },

    // Desktop: no llama-server yet (Phase 4).
    "llamacpp-desktop": {
      "models": {
        // Model ids are the preset's section names / aliases
        // (server/llamacpp/models.ini), same tags as the ollama-desktop seats.
        // Text only: the vision projector (mmproj) is not loaded, so these do not
        // list image input even where the Ollama copy does. No "npm" field: OpenCode
        // gives a config-defined provider @ai-sdk/openai-compatible (docs/llamacpp-trial.md, step 6).
        "qwen3.6:35b-a3b-coding": {
          "name": "Qwen3.6 35B-A3B Coding (Desktop, main seat, llama.cpp)",
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 65536, "output": 8192 }
        },
        "qwen3:8b": {
          "name": "Qwen3 8B (Desktop, llama.cpp)",
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 32768, "output": 4096 }
        },
        "qwen2.5-coder-3b-cpu": {
          "name": "Qwen 2.5 Coder 3B (Desktop, CPU, small, llama.cpp)",
          "attachment": false,
          "reasoning": false,
          "tool_call": false,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 2048 }
        }
      },
      "options": {
        "baseURL": "{env:LLAMACPP_DESKTOP_BASE_URL}"
      }
    },

    // Node3: no llama-server yet (Phase 5).
    "llamacpp-node3": {
      "models": {
        // Model ids are the preset's section names / aliases
        // (server/llamacpp/models.ini), same tags as the ollama-node3 seats.
        // Text only: the vision projector (mmproj) is not loaded, so these do not
        // list image input even where the Ollama copy does. No "npm" field: OpenCode
        // gives a config-defined provider @ai-sdk/openai-compatible (docs/llamacpp-trial.md, step 6).
        "qwen3.6:35b-a3b-coding": {
          "name": "Qwen3.6 35B-A3B Coding (Node3, main seat, llama.cpp)",
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 65536, "output": 8192 }
        },
        "qwen3:8b": {
          "name": "Qwen3 8B (Node3, llama.cpp)",
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 32768, "output": 4096 }
        },
        "qwen2.5-coder-3b-cpu": {
          "name": "Qwen 2.5 Coder 3B (Node3, CPU, small, llama.cpp)",
          "attachment": false,
          "reasoning": false,
          "tool_call": false,
          "modalities": { "input": ["text"], "output": ["text"] },
          "cost": { "input": 0, "output": 0, "cache_read": 0, "cache_write": 0 },
          "limit": { "context": 16384, "output": 2048 }
        }
      },
      "options": {
        "baseURL": "{env:LLAMACPP_NODE3_BASE_URL}"
      }
    }
  },

  "permission": {
    "edit": "ask",
    "bash": "ask"
  },

  // ---------------------------------------------------------------------
  // MCP servers live in PROJECT configs, not here.
  //
  // Every MCP server injects its full tool schema into the system prompt of
  // EVERY request, on every project. The five servers that used to live here
  // (vercel, render, docker, browser, postgres - ~105 tools between them)
  // were the bulk of a 46,505-token preamble that no 16k-32k local model can
  // hold.
  //
  // opencode deep-merges project config over global, so each project turns on
  // exactly what it needs in its own opencode.jsonc - and can switch off an
  // inherited server with { "enabled": false }. See
  // opencode/project-override/opencode.jsonc for the template.
  // ---------------------------------------------------------------------
  "mcp": {}
}
