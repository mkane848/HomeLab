# Shared environment for the profiles, sync scripts and harness.
# Copy to .env at the repo root (git-ignored). Profiles source it themselves.
#
# API keys are NOT stored here. They live in:
#   ~/.config/opencode/.secrets/opencode-go-api-key

# Network (machines.tsv names the roles; hosts are often down)
SERVER_IP=
DESKTOP_IP=
NODE3_IP=

# SSH
SSH_USER=

# llama.cpp (Replacing Ollama, Phase 2). The profiles export these; set them here or as
# User-level defaults only to override. {env:...} has no fallbacks, so each must be non-empty.
# LLAMACPP_SERVER_BASE_URL=http://SERVER_IP:8090/v1
# LLAMACPP_SERVER_SSH=server        # ssh target for the harness placement check
