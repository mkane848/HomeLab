# Server-side Ollama config
# Copy to .env and adjust as needed. Every value here is optional: the compose
# file carries the same defaults, aligned with the desktop's measured setup
# (docs/roadmap.md -> "Next up", step 2).

# Number of parallel requests. 1: four KV slots of a 64k 35B seat do not fit on
# 16GB, and the harness / OpenCode are single-stream. Raise only for small models.
OLLAMA_NUM_PARALLEL=1

# Max models loaded simultaneously (2 = the main seat + the CPU-pinned 3b companion)
OLLAMA_MAX_LOADED_MODELS=2

# Context length for tags that are NOT baked (Linux/Docker honors this env var).
# Seats get their own num_ctx from server/scripts/bake-models.sh, which mirrors the
# desktop's startup.ps1 $contextModels - the two are one contract with opencode.jsonc.
OLLAMA_CONTEXT_LENGTH=16384

# Flash attention is required for a quantized KV cache. q8_0 halves the KV
# footprint versus f16, which is what fits a 64k seat beside its companion.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# How long a model stays loaded after its last request (Ollama default: 5m).
OLLAMA_KEEP_ALIVE=4h

# Host binding
OLLAMA_HOST=0.0.0.0
