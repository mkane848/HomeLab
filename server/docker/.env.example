# Server-side Ollama config
# Copy to .env and adjust as needed

# Number of parallel requests (higher = more concurrency, more VRAM)
# 16GB VRAM host: 4 is comfortable for 7B/14B models.
OLLAMA_NUM_PARALLEL=4

# Max models loaded simultaneously (2 fits 7B + 14B; Ollama evicts beyond VRAM)
OLLAMA_MAX_LOADED_MODELS=2

# Context length cap for base tags (Linux/Docker honors this env var).
# Raised from 8192 -> 16384 for the 4070 Ti Super. To give ONE model more,
# either raise this (all models) or bake num_ctx via install-model.sh --ctx N.
OLLAMA_CONTEXT_LENGTH=16384

# Host binding
OLLAMA_HOST=0.0.0.0