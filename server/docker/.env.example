# server/docker/.env - values the server's compose files read (copy this file to .env; .env is git-ignored).
# The llama.cpp stack (docker-compose.llamacpp.yml) needs nothing from here; its API key file is outside the repo
# (docs/engine-api-keys.md). The household stack (docker-compose.household.yml) refuses to start without these:

# Pinned image tags (never :latest; docs/household/phase1.md, docs/household/phase2-chat.md).
GROCY_TAG=
OPENWEBUI_TAG=

# The household chat's own llama.cpp key, so it can be revoked without touching the fleet's (docs/engine-api-keys.md).
LLAMACPP_HOUSEHOLD_KEY=

# Keeps logins across container rebuilds (openssl rand -hex 32). Keep a copy off the server.
WEBUI_SECRET_KEY=

# Optional (the compose file's defaults shown).
# HOUSEHOLD_PUID=1000
# HOUSEHOLD_PGID=1000
# HOUSEHOLD_TZ=America/New_York
