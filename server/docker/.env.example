# Server-side Ollama config
# Copy to .env and adjust as needed. The defaults in docker-compose.yml are the
# desktop's measured setup (aligned 2026-10-10); change one here and the
# server's results stop comparing with the desktop's.

# Parallel requests per model. Each gets its own KV slot: 1, because four 64k
# slots of the 35B main seat do not fit 16 GB.
OLLAMA_NUM_PARALLEL=1

# Max models loaded at once (Ollama evicts beyond VRAM).
OLLAMA_MAX_LOADED_MODELS=2

# Global default context. The seats' own contexts are baked into their tags by
# server/scripts/bake-models.sh (models/server-seats.tsv).
OLLAMA_CONTEXT_LENGTH=16384

# Flash attention + 8-bit KV cache, as on the desktop.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# How long an idle model stays loaded (desktop: 4h).
OLLAMA_KEEP_ALIVE=4h

# Host binding
OLLAMA_HOST=0.0.0.0
