+  const subtypeWords = subtypePart.trim().split(/\s+/).filter(Boolean);
+  const foundTypes = new Set<string>();
+
+  if (knownTypes) {
+    // First, try to match multi-word creature types by checking adjacent word combinations
+    for (let i = 0; i < subtypeWords.length; i++) {
+      let accumulated = subtypeWords[i];
+      for (let j = i + 1; j < subtypeWords.length; j++) {
+        accumulated += ' ' + subtypeWords[j];
+        if (knownTypes.has(accumulated)) {
+          foundTypes.add(accumulated);
+        }
+        // Stop extending if we've already found a matching multi-word type starting here
+        // or if this doesn't lead to a known type
+        if (i < j - 1 && !knownTypes.has(subtypeWords[i] + ' ' + subtypeWords[j])) {
+          continue;
+        }
+      }
+    }
+
+    // Then, for single words that are followed by something that's not the rest of a known type,
+    // check if the single word itself is a known type
+    for (const word of subtypeWords) {
+      if (knownTypes.has(word)) {
+        foundTypes.add(word);
+      }
+    }
+  } else {
+    // Fallback to checking each word individually
+    return subtypeWords;
+  }
+
+  return [...foundTypes];
 }
 
