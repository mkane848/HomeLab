@@ -468,4 +468,36 @@ describe('creature types: the vocabulary the rest of this depends on', () => {
     assert.deepStrictEqual(parseCreatureTypes('Battle — Control Point'), []);
     assert.deepStrictEqual(parseCreatureTypes('Creature — Goblin Wizard'), ['Goblin', 'Wizard']);
   });
+
+  it('recognizes "Time Lord" as a single multi-word creature type', () => {
+    const multiWordTypes = new Set(['Time Lord']);
+    const timeLordType = 'Creature — Time Lord';
+    assert.deepStrictEqual(
+      parseCreatureTypes(timeLordType, multiWordTypes),
+      ['Time Lord'],
+    );
+  });
+
+  it('recognizes "Time Lord" while also extracting independently-known types', () => {
+    // Multi-word type with a standalone type mixed in
+    const hybridTypes = new Set(['Goblin', 'Warrior', 'Time Lord']);
+    const hybridCreature = 'Creature — Time Lord Warrior';
+    assert.deepStrictEqual(
+      parseCreatureTypes(hybridCreature, hybridTypes),
+      ['Time Lord', 'Warrior'],
+    );
+  });
+
+  it('does not prematurely match as multi-word when only the first word appears', () => {
+    // "Time" alone is known, but "Time" is NOT a type here
+    // A creature with "...Time Wizard..." should match "Wizard" but NOT "Time"
+    // even though "Time Lord" exists in the known types.
+    const partialMatchTypes = new Set(['Time Lord', 'Wizard']);
+    const timeWizardCreature = 'Creature — Wizard Time';
+    // Only "Wizard" should match; "Time" is not kept because it's not followed by "Lord"
+    assert.deepStrictEqual(
+      parseCreatureTypes(timeWizardCreature, partialMatchTypes),
+      ['Wizard'],
+    );
+  });
 });
