+  it('a genuinely unparseable "up to N" phrase defaults to 1 and warns', () => {
+    // spy on console.warn to verify it was called
+    const originalWarn = console.warn;
+    let warnCalled = false;
+    console.warn = () => {
+      warnCalled = true;
