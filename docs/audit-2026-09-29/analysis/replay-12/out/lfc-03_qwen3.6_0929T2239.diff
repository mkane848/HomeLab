+
+describe('status transition matrix', () => {
+  function seedActiveListing() {
+    seedServer();
+    return createListing({ ...baseInput(), intent: 'have', accepts: 'cash' }).listing;
+  }
+
+  it('active -> fulfilled is allowed', () => {
+    const listing = seedActiveListing();
+    const result = fulfillListing(listing.id);
+    expect(result?.status).toBe('fulfilled');
+  });
+
+  it('active -> deleted is allowed', () => {
+    const listing = seedActiveListing();
+    const result = softDeleteListing(listing.id);
+    expect(result?.status).toBe('deleted');
+  });
+
+  it('fulfilled -> deleted is allowed', () => {
+    const listing = seedActiveListing();
+    fulfillListing(listing.id);
+    const result = softDeleteListing(listing.id);
+    expect(result?.status).toBe('deleted');
+  });
+
+  it('fulfilled -> fulfilled throws and leaves status unchanged', () => {
+    const listing = seedActiveListing();
+    fulfillListing(listing.id);
+    expect(getListingById(listing.id)?.status).toBe('fulfilled');
+    expect(() => fulfillListing(listing.id)).toThrow(/cannot transition/);
+    expect(getListingById(listing.id)?.status).toBe('fulfilled');
+  });
+
+  it('deleted -> fulfilled throws and leaves status unchanged', () => {
+    const listing = seedActiveListing();
+    softDeleteListing(listing.id);
+    const beforeStatus = getListingById(listing.id)?.status;
+    expect(() => fulfillListing(listing.id)).toThrow(/cannot transition/);
+    expect(getListingById(listing.id)?.status).toBe(beforeStatus);
+  });
+
+  it('deleted -> deleted throws and leaves status unchanged', () => {
+    const listing = seedActiveListing();
+    softDeleteListing(listing.id);
+    const beforeStatus = getListingById(listing.id)?.status;
+    expect(() => softDeleteListing(listing.id)).toThrow(/cannot transition/);
+    expect(getListingById(listing.id)?.status).toBe(beforeStatus);
+  });
+
+  it('re-fulfilling an already-fulfilled listing via softDeleteListing throws', () => {
+    const listing = seedActiveListing();
+    fulfillListing(listing.id);
+    expect(getListingById(listing.id)?.status).toBe('fulfilled');
+    expect(() => softDeleteListing(listing.id)).not.toThrow();
+  });
+});
