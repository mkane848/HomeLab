diff --git a/src/services/listings.ts b/src/services/listings.ts
index fc95784..854e08c 100644
--- a/src/services/listings.ts
+++ b/src/services/listings.ts
@@ -294,8 +294,23 @@ export function softDeleteListing(id: number): ListingRow | undefined {
   return setStatus(id, 'deleted');
 }
 
+const VALID_TRANSITIONS: Record<string, Set<string>> = {
+  active: new Set(['fulfilled', 'deleted']),
+  fulfilled: new Set(['deleted']),
+};
+
 function setStatus(id: number, status: 'fulfilled' | 'deleted'): ListingRow | undefined {
   const db = getDb();
+  const listing = db.select({ status: listings.status }).from(listings).where(eq(listings.id, id)).get();
+  if (!listing) {
+    return undefined;
+  }
+  const allowed = VALID_TRANSITIONS[listing.status];
+  if (!allowed || !allowed.has(status)) {
+    throw new Error(
+      `cannot transition listing #${id} from '${listing.status}' to '${status}'`,
+    );
+  }
   db.update(listings).set({ status, updatedAt: now() }).where(eq(listings.id, id)).run();
   return getListingById(id);
 }
