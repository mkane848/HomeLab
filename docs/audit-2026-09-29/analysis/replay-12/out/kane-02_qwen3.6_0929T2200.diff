-  return knownTypes ? words.filter((word) => knownTypes.has(word)) : words;
+  if (!knownTypes) return words;
+
+  const lowerToCanonical = new Map<string, string>();
+  for (const t of knownTypes) lowerToCanonical.set(t.toLowerCase(), t);
+
+  // Separate single-word and multi-word types for efficient lookup.
+  const multiWordTypes = new Map<string, string>();
+  for (const t of knownTypes) {
+    if ((t.toLowerCase().split(' ')).length > 1) {
+      multiWordTypes.set(t.toLowerCase(), t);
+    }
+  }
+
+  const found: string[] = [];
+  const used = new Set<number>();
+
+  // First pass: greedily match multi-word types left-to-right, mark consumed
+  // positions so those words cannot later match as single words.
+  for (let pos = 0; pos < words.length; pos++) {
+    for (const [mlower, canonical] of multiWordTypes) {
+      const parts = mlower.split(' ');
+      if (words.length - pos < parts.length) continue;
+      let ok = true;
+      for (let j = 0; j < parts.length; j++) {
+        if (words[pos + j]!.toLowerCase() !== parts[j]) { ok = false; break; }
+      }
+      if (ok) {
+        for (let i = pos; i < pos + parts.length; i++) used.add(i);
+        found.push(canonical);
+        break;
+      }
+    }
+  }
+
+  // Second pass: for unused positions, check if the word matches a
+  // single-word type directly (case-insensitive).
+  for (let i = 0; i < words.length; i++) {
+    if (used.has(i)) continue;
+    const c = lowerToCanonical.get(words[i]!.toLowerCase());
+    if (c && !found.includes(c)) found.push(c);
+  }
+
+  return found;
 }
 
