--- a/apps/commander-recommender/server/src/services/signals.test.ts
+++ b/apps/commander-recommender/server/src/services/signals.test.ts
@@ -468,4 +468,31 @@ describe('creature types: the vocabulary the rest of this depends on', () => {
     assert.deepStrictEqual(parseCreatureTypes('Battle — Control Point'), []);
     assert.deepStrictEqual(parseCreatureTypes('Creature — Goblin Wizard'), ['Goblin', 'Wizard']);
   });
+
+  it('recognizes a multi-word creature type present in the catalog', () => {
+    // "Time Lord" is the one multi-word creature type in Magic's catalog.
+    const withTimeLord = new Set([...CREATURE_TYPES, 'Time Lord']);
+    assert.deepStrictEqual(
+      parseCreatureTypes('Creature — Time Lord', withTimeLord),
+      ['Time Lord'],
+    );
+  });
+
+  it('does not keep a prefix-only word when the full multi-word type is absent', () => {
+    // knownTypes has 'Time Lord' but the card says 'Time Wizard'.
+    // 'Time' by itself is NOT a creature type, so it must not be kept.
+    const withTimeLord = new Set([...CREATURE_TYPES, 'Time Lord']);
+    assert.deepStrictEqual(
+      parseCreatureTypes('Creature — Time Wizard', withTimeLord),
+      [],
+    );
+  });
+
+  it('still works with ordinary single-word types', () => {
+    const withTimeLord = new Set([...CREATURE_TYPES, 'Time Lord']);
+    assert.deepStrictEqual(
+      parseCreatureTypes('Creature — Goblin Knight Elf', withTimeLord),
+      ['Goblin', 'Knight', 'Elf'],
+    );
+  });
 });
