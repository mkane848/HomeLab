 function setStatus(id: number, status: 'fulfilled' | 'deleted'): ListingRow | undefined {
   const db = getDb();
+  const current = db.select({ status: listings.status }).from(listings).where(eq(listings.id, id)).get();
+  if (!current) {
+    return undefined;
+  }
+  const allowed = new Set<string>(
+    current.status === 'active'
+      ? ['fulfilled', 'deleted']
+      : current.status === 'fulfilled'
+        ? ['deleted']
+        : [],
+  );
+  if (!allowed.has(status)) {
+    throw new Error(
+      `cannot transition from '${current.status}' to '${status}' (listing #${id})`,
+    );
+  }
   db.update(listings).set({ status, updatedAt: now() }).where(eq(listings.id, id)).run();
   return getListingById(id);
 }
