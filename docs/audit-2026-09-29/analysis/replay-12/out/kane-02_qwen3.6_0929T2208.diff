@@ -260,8 +260,39 @@ export function parseCreatureTypes(typeLine: string, knownTypes?: Set<string>):
   // whose subtype happened to read "Creature" would otherwise slip through.
   if (!/\b(Creature|Kindred|Tribal)\b/.test(typePart!)) return [];
 
-  const words = subtypePart.trim().split(/\s+/).filter(Boolean);
-  return knownTypes ? words.filter((word) => knownTypes.has(word)) : words;
+  const raw = subtypePart.trim().split(/\s+/).filter(Boolean);
+
+  // knownTypes is a Set whose keys are the canonical types (e.g. "Time Lord").
+  // We build a set of what's available so multi-word types can be recognised
+  // before falling back to the single-word path.
+  if (knownTypes) {
+    // 1) Look for multi-word matches first (longest token sequences that form a known type).
+    const found = new Set<string>();
+    let i = 0;
+    while (i < raw.length) {
+      let best = 0;
+      for (let len = Math.min(5, raw.length - i); len >= 2; len--) {
+        if (len < best) break; // already found a longer match starting here
+        const candidate = raw.slice(i, i + len).join(' ');
+        if (knownTypes.has(candidate)) {
+          best = len;
+        }
+      }
+      if (best > 0) {
+        found.add(raw.slice(i, i + best).join(' '));
+        i += best;
+      } else {
+        // 2) No multi-word match; check single word against catalog.
+        if (knownTypes.has(raw[i])) {
+          found.add(raw[i]);
+        }
+        i++;
+      }
+    }
+    return [...found];
+  }
+
+  return raw;
 }
 
