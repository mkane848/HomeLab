+function multiWordTypes(subtypePart: string, knownTypes: Set<string>): string[] {
+  const words = subtypePart.split(/\s+/);
+  const found = new Set<string>();
+
+  for (let i = 0; i < words.length - 1; i++) {
+    const phrase = `${words[i]} ${words[i + 1]}`;
+    if (knownTypes.has(phrase)) {
+      found.add(phrase);
+      i++; // Skip the next word since it's part of this multi-word type
+    }
+  }
+
+  return [...found];
+}
