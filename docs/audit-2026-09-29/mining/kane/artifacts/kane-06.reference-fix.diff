+/** First-seen order, one entry per key. */
+function distinctBy(items: { name: string; key: string }[]): string[] {
+  const seen = new Set<string>();
+  const out: string[] = [];
+  for (const { name, key } of items) {
+    if (seen.has(key)) continue;
+    seen.add(key);
+    out.push(name);
+  }
+  return out;
+}
