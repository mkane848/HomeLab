# Desktop local service stack config
# Copy this file to .env in the SAME directory and fill in real values.
# `docker compose up` fails fast until POSTGRES_PASSWORD is set - no default
# password is shipped anywhere.

# Local dev Postgres (loopback-only. The read-only pg-ro-mcp OpenCode provider
# consumes the same DSN - see .secrets/postgres-dsn).
POSTGRES_USER=dev
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=dev

# Port overrides - keep on 127.0.0.1; the compose file binds loopback explicitly.
# POSTGRES_PORT=5432
# REDIS_PORT=6379